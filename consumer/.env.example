# Development proxy only. Never place an API key in frontend environment variables.
NEW_API_BACKEND=http://127.0.0.1:3000

# Optional public presentation values, applied when building consumer.
# Put deployment-specific values in .env.local (ignored by Git and Docker).
# Names/logo/domain otherwise use the existing backend site settings.
# These PUBLIC_ values are included in browser assets. Never put secrets here.
PUBLIC_SITE_NAME=
PUBLIC_SITE_DOMAIN=
PUBLIC_SITE_TITLE=
PUBLIC_SITE_DESCRIPTION=
PUBLIC_SITE_LOGO_URL=
# Empty defaults to Simplified Chinese; choices: en, zh, zh-TW, fr, ja, ru, vi.
PUBLIC_DEFAULT_LANGUAGE=
